{
  "name": "bridged-apps",
  "version": "1.0.0",
  "private": true,
  "description": "PlayBridge-enabled companion web apps and media clients",
  "scripts": {
    "dev:jellyfin": "pnpm --filter @bridged-apps/jellyfin dev",
    "dev:streams": "pnpm --filter @bridged-apps/streams dev",
    "build:jellyfin": "pnpm --filter @bridged-apps/jellyfin build",
    "build:streams": "pnpm --filter @bridged-apps/streams build",
    "check": "pnpm -r check",
    "build": "pnpm -r build",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:streams": "playwright test -c e2e/streams.config.ts",
    "test:e2e:obscura": "USE_OBSCURA=1 playwright test -c e2e/playwright.config.ts"
  },
  "keywords": [
    "playbridge",
    "casting",
    "jellyfin",
    "web-apps",
    "media"
  ],
  "author": "PlayBridge",
  "license": "GPL-3.0",
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
