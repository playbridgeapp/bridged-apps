# Copy to e2e/.env.local or export in the shell. Never commit real tokens.
# Live smoke tests skip unless URL + token + user id are set.

JELLYFIN_URL=
JELLYFIN_TOKEN=
JELLYFIN_USER_ID=
JELLYFIN_USERNAME=admin
JELLYFIN_SERVER_NAME=Jellyfin

# Optional second server — switch-account tests skip unless all three are set
JELLYFIN_B_URL=
JELLYFIN_B_TOKEN=
JELLYFIN_B_USER_ID=
JELLYFIN_B_USERNAME=admin
JELLYFIN_B_SERVER_NAME=Jellyfin

# Optional Obscura (https://github.com/h4ckf0r0day/obscura)
# USE_OBSCURA=1
# OBSCURA_BIN=obscura
# OBSCURA_PORT=9222
# OBSCURA_CDP=ws://127.0.0.1:9222
